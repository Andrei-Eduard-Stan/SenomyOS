#!/usr/bin/env python3
"""Terminal-only credential prompt. No credentials cross QML or shell argv."""
import getpass,subprocess,sys,re
if len(sys.argv)!=2 or not re.fullmatch(r'[a-f0-9]{32}',sys.argv[1]): raise SystemExit('Use a calendar account ID.')
password=getpass.getpass('CalDAV application password (stored in Secret Service): ')
if not password: raise SystemExit('Credential was not stored.')
result=subprocess.run(['secret-tool','store','--label=Senomy Calendar account','application','senomy-calendar','account',sys.argv[1]],input=password+'\n',text=True)
password=''
if result.returncode: raise SystemExit('Secret Service did not store the credential.')
print('Credential stored. Return to Calendar Accounts and choose Sync.')
