#!/usr/bin/env bash

set -euo pipefail

SCRIPT_PATH="$(readlink -f "${BASH_SOURCE[0]}")"
SOURCE_ROOT="${SENOMY_SOURCE_ROOT:-$(cd "$(dirname "$SCRIPT_PATH")/.." && pwd -P)}"
BIN_ROOT="${XDG_BIN_HOME:-$HOME/.local/bin}"
UNIT_ROOT="${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user"
CONFIG_ROOT="${XDG_CONFIG_HOME:-$HOME/.config}/senomyos"

declare -a LINKS=(
  "$SOURCE_ROOT/scripts/senomy-app-launch|$BIN_ROOT/senomy-app-launch"
  "$SOURCE_ROOT/scripts/senomy_app_launch.py|$BIN_ROOT/senomy_app_launch.py"
  "$SOURCE_ROOT/scripts/senomy-shell|$BIN_ROOT/senomy-shell"
  "$SOURCE_ROOT/scripts/senomy-surface|$BIN_ROOT/senomy-surface"
  "$SOURCE_ROOT/scripts/senomy-provider-setup|$BIN_ROOT/senomy-provider-setup"
  "$SOURCE_ROOT/scripts/senomy-screenshot|$BIN_ROOT/senomy-screenshot"
  "$SOURCE_ROOT/components/settings/senomy-settings.desktop|${XDG_DATA_HOME:-$HOME/.local/share}/applications/senomy-settings.desktop"
  "$SOURCE_ROOT/components/settings/senomy-control.desktop|${XDG_DATA_HOME:-$HOME/.local/share}/applications/senomy-control.desktop"
  "$SOURCE_ROOT/scripts/senomy-desktop-probe.py|$BIN_ROOT/senomy-desktop-probe"
  "$SOURCE_ROOT/scripts/senomy-dev|$BIN_ROOT/senomy-dev"
  "$SOURCE_ROOT/scripts/senomy-quickshell-run|$BIN_ROOT/senomy-quickshell-run"
  "$SOURCE_ROOT/scripts/senomy-calendar-run|$BIN_ROOT/senomy-calendar-run"
  "$SOURCE_ROOT/scripts/senomy-calendar-setup|$BIN_ROOT/senomy-calendar-setup"
  "$SOURCE_ROOT/scripts/senomy-calendar-credential|$BIN_ROOT/senomy-calendar-credential"
  "$SOURCE_ROOT/scripts/senomy-calendar-batch|$BIN_ROOT/senomy-calendar-batch"
  "$SOURCE_ROOT/systemd/senomy-calendar.service|$UNIT_ROOT/senomy-calendar.service"
  "$SOURCE_ROOT/scripts/senomy-session-action|$BIN_ROOT/senomy-session-action"
  "$SOURCE_ROOT/shell/quickshell/scripts/display-action.py|$BIN_ROOT/senomy-display-action"
  "$SOURCE_ROOT/shell/quickshell/scripts/display_core.py|$BIN_ROOT/display_core.py"
  "$SOURCE_ROOT/shell/quickshell/scripts/input-settings.py|$BIN_ROOT/senomy-input-settings"
  "$SOURCE_ROOT/shell/quickshell/scripts/session-policy.py|$BIN_ROOT/senomy-session-policy"
  "$SOURCE_ROOT/systemd/senomy-quickshell.service|$UNIT_ROOT/senomy-quickshell.service"
)

plan() {
  local entry source target
  for entry in "${LINKS[@]}"; do
    IFS='|' read -r source target <<<"$entry"
    printf '%s -> %s\n' "$target" "$source"
  done
  printf '%s (generated only when absent; login default is Quickshell)\n'  "$CONFIG_ROOT/shell.json"
}

check() {
  local entry source target failed=0
  for entry in "${LINKS[@]}"; do
    IFS='|' read -r source target <<<"$entry"
    if [[ -L "$target" && "$(readlink -f "$target")" == "$(readlink -f "$source")" ]]; then
      printf 'OK   %s\n' "$target"
    else
      printf 'MISS %s\n' "$target"
      failed=1
    fi
  done
  return "$failed"
}

apply() {
  local entry source target
  for entry in "${LINKS[@]}"; do
    IFS='|' read -r source target <<<"$entry"
    [[ -e "$source" ]] || { printf 'missing source: %s\n' "$source" >&2; return 1; }
    if [[ -e "$target" || -L "$target" ]]; then
      [[ -L "$target" && "$(readlink -m "$target")" == "$(realpath -m "$source")" ]] || { printf 'refusing unmanaged target: %s\n' "$target" >&2; return 1; }
    fi
  done
  mkdir -p "$BIN_ROOT" "$UNIT_ROOT" "$CONFIG_ROOT"
  for entry in "${LINKS[@]}"; do
    IFS='|' read -r source target <<<"$entry"
    [[ -e "$source" ]] || { printf 'missing source: %s\n' "$source" >&2; exit 1; }
    if [[ -e "$target" || -L "$target" ]]; then
      [[ -L "$target" && "$(readlink -f "$target")" == "$(readlink -f "$source")" ]] || {
        printf 'refusing to replace unmanaged target: %s\n' "$target" >&2
        exit 1
      }
    else
      mkdir -p "$(dirname "$target")"
      ln -s "$source" "$target"
    fi
  done
  if [[ ! -e "$CONFIG_ROOT/shell.json" ]]; then
    /usr/bin/jq -n --arg source "$SOURCE_ROOT" \
      '{schema_version:1,selected_backend:"quickshell",source_root:$source,login_default:"quickshell",reason:"initial-deploy"}' >"$CONFIG_ROOT/shell.json"
    chmod 600 "$CONFIG_ROOT/shell.json"
  fi
  systemctl --user daemon-reload
  printf 'Quickshell shell links installed. Hyprland owns login activation; no service was enabled or started here.\n'
}

case "${1:-}" in
  plan) plan ;;
  check) check ;;
  apply) apply ;;
  *)
    printf 'usage: senomy-v2-deploy {plan|apply|check}\n' >&2
    exit 64
    ;;
esac
