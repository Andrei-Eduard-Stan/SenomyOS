#!/usr/bin/env bash

# Recovery is Wayland-only. Ordinary users retain SDDM's standard X11 path.

set -euo pipefail
export LC_ALL=C

readonly RECOVERY_USER=senomy-recovery
readonly STANDARD_SESSION=/usr/share/sddm/scripts/Xsession

[[ -x "$STANDARD_SESSION" && ! -L "$STANDARD_SESSION" ]] || {
  printf 'SenomyOS SDDM: standard X11 session launcher is unavailable.\n' >&2
  exit 78
}

if [[ "$(/usr/bin/id -un)" == "$RECOVERY_USER" ]]; then
  printf 'SenomyOS recovery: X11 sessions are denied.\n' >&2
  exit 77
fi

exec "$STANDARD_SESSION" "$@"
