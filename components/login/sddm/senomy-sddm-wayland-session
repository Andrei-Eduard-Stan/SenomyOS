#!/usr/bin/env bash

# Preserve SDDM's standard Wayland session path for ordinary users while
# confining the separately authenticated recovery account to its one session.

set -euo pipefail
export LC_ALL=C

readonly RECOVERY_USER=senomy-recovery
readonly RECOVERY_SESSION=/usr/local/libexec/senomy-recovery-session
readonly STANDARD_SESSION=/usr/share/sddm/scripts/wayland-session

[[ -x "$STANDARD_SESSION" && ! -L "$STANDARD_SESSION" ]] || {
  printf 'SenomyOS SDDM: standard Wayland session launcher is unavailable.\n' >&2
  exit 78
}

if [[ "$(/usr/bin/id -un)" == "$RECOVERY_USER" ]]; then
  [[ $# -eq 1 && "$1" == "$RECOVERY_SESSION" ]] || {
    printf 'SenomyOS recovery: ordinary Wayland sessions are denied.\n' >&2
    exit 77
  }
fi

exec "$STANDARD_SESSION" "$@"
