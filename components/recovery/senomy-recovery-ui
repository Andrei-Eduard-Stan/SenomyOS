#!/usr/bin/env python3
"""Restricted SenomyOS password-reset UI for the recovery account."""

from __future__ import annotations

import os
from pathlib import Path
import re
import subprocess
import sys

import gi

gi.require_version("Gtk", "3.0")
from gi.repository import Gdk, GdkPixbuf, GLib, Gtk  # noqa: E402


CONFIG = Path("/etc/senomyos/recovery.conf")
HELPER = "/usr/local/libexec/senomy-password-reset-helper"
AVATAR = "/usr/share/sddm/themes/senomyos/assets/avatar.png"
RECOVERY_USER = "senomy-recovery"


def target_user() -> str:
    try:
        payload = CONFIG.read_text(encoding="utf-8")
    except OSError:
        return ""
    match = re.fullmatch(r"TARGET_USER=([A-Za-z_][A-Za-z0-9_.-]{0,31})\n?", payload)
    return match.group(1) if match else ""


class RecoveryWindow(Gtk.Window):
    def __init__(self) -> None:
        super().__init__(title="Senomy Recovery")
        self.set_name("recovery-window")
        self.set_wmclass("senomy-recovery", "senomy-recovery")
        self.set_decorated(False)
        self.set_keep_above(True)
        self.set_default_size(960, 640)
        self.connect("destroy", self._leave_session)

        css = Gtk.CssProvider()
        css.load_from_data(
            b"""
            #recovery-window { background: #08090b; color: #f1f1f4; }
            #rail { background: rgba(10,12,15,0.97); border: 1px solid rgba(255,255,255,0.22); border-radius: 6px; }
            #eyebrow { color: #9892e8; font: 600 13px 'JetBrainsMono Nerd Font'; letter-spacing: 2px; }
            #title { color: #f1f1f4; font: 600 28px 'JetBrainsMono Nerd Font'; }
            #body { color: #92959f; font: 13px 'JetBrainsMono Nerd Font'; }
            #status { color: #92959f; font: 12px 'JetBrainsMono Nerd Font'; }
            entry { min-height: 48px; padding: 0 14px; color: #f1f1f4; background: #0f1115; border: 1px solid rgba(255,255,255,0.28); border-radius: 4px; font: 15px 'JetBrainsMono Nerd Font'; }
            entry:focus { border-color: #9892e8; box-shadow: inset 0 0 0 1px #9892e8; }
            button { min-height: 48px; padding: 0 20px; color: #f1f1f4; background: #0f1115; border: 1px solid rgba(255,255,255,0.25); border-radius: 4px; font: 600 13px 'JetBrainsMono Nerd Font'; }
            button:hover, button:focus { border-color: #9892e8; background: rgba(152,146,232,0.12); }
            button#primary { color: #08090b; background: #9892e8; border-color: #9892e8; }
            button#primary:disabled { background: #666a74; border-color: #666a74; }
            """
        )
        screen = Gdk.Screen.get_default()
        if screen is not None:
            Gtk.StyleContext.add_provider_for_screen(
                screen, css, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION
            )

        overlay = Gtk.Overlay()
        self.add(overlay)

        rail = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=16)
        rail.set_name("rail")
        rail.set_halign(Gtk.Align.CENTER)
        rail.set_valign(Gtk.Align.CENTER)
        rail.set_size_request(700, 560)
        rail.set_margin_start(24)
        rail.set_margin_end(24)
        rail.set_margin_top(24)
        rail.set_margin_bottom(24)
        overlay.add(rail)

        content = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=16)
        content.set_margin_start(58)
        content.set_margin_end(58)
        content.set_margin_top(40)
        content.set_margin_bottom(40)
        rail.pack_start(content, True, True, 0)

        avatar = Gtk.Image()
        try:
            pixbuf = GdkPixbuf.Pixbuf.new_from_file_at_scale(AVATAR, 112, 112, True)
            avatar.set_from_pixbuf(pixbuf)
        except GLib.Error:
            pass
        content.pack_start(avatar, False, False, 0)

        eyebrow = Gtk.Label(label="SENOMY // AUTHENTICATED RECOVERY")
        eyebrow.set_name("eyebrow")
        content.pack_start(eyebrow, False, False, 0)

        title = Gtk.Label(label="RESET ACCOUNT PASSWORD")
        title.set_name("title")
        content.pack_start(title, False, False, 0)

        self.target = target_user()
        description = Gtk.Label()
        description.set_name("body")
        description.set_line_wrap(True)
        description.set_justify(Gtk.Justification.CENTER)
        description.set_text(
            f"Set a new password for {self.target}. This restricted session cannot open "
            "the desktop, a browser, a launcher, or a shell."
            if self.target
            else "Recovery is not provisioned. Return to sign-in and run the recovery setup."
        )
        content.pack_start(description, False, False, 0)

        self.password = Gtk.Entry()
        self.password.set_visibility(False)
        self.password.set_input_purpose(Gtk.InputPurpose.PASSWORD)
        self.password.set_placeholder_text("NEW PASSWORD — 12 CHARACTERS MINIMUM")
        self.password.connect("changed", self._update_ready)
        content.pack_start(self.password, False, False, 0)

        self.confirm = Gtk.Entry()
        self.confirm.set_visibility(False)
        self.confirm.set_input_purpose(Gtk.InputPurpose.PASSWORD)
        self.confirm.set_placeholder_text("CONFIRM NEW PASSWORD")
        self.confirm.connect("changed", self._update_ready)
        self.confirm.connect("activate", self._apply)
        content.pack_start(self.confirm, False, False, 0)

        self.status = Gtk.Label(label="Recovery uses a separate credential and resets only the configured account.")
        self.status.set_name("status")
        self.status.set_line_wrap(True)
        content.pack_start(self.status, False, False, 0)

        actions = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=12)
        actions.set_halign(Gtk.Align.CENTER)
        content.pack_end(actions, False, False, 0)

        leave = Gtk.Button(label="RETURN TO SIGN-IN")
        leave.connect("clicked", self._leave_session)
        actions.pack_start(leave, False, False, 0)

        self.apply = Gtk.Button(label="RESET PASSWORD")
        self.apply.set_name("primary")
        self.apply.set_sensitive(False)
        self.apply.connect("clicked", self._apply)
        actions.pack_start(self.apply, False, False, 0)

    def _update_ready(self, _entry: Gtk.Entry) -> None:
        new_password = self.password.get_text()
        confirmation = self.confirm.get_text()
        self.apply.set_sensitive(
            bool(self.target)
            and len(new_password) >= 12
            and new_password == confirmation
            and ":" not in new_password
        )

    def _apply(self, _widget: Gtk.Widget) -> None:
        if not self.apply.get_sensitive():
            self.status.set_text("Passwords must match and contain at least 12 characters.")
            return

        new_password = self.password.get_text()
        confirmation = self.confirm.get_text()
        self.apply.set_sensitive(False)
        self.status.set_text("RESETTING PASSWORD…")
        while Gtk.events_pending():
            Gtk.main_iteration_do(False)

        try:
            completed = subprocess.run(
                ["/usr/bin/sudo", "-n", HELPER],
                input=f"{new_password}\n{confirmation}\n",
                text=True,
                stdout=subprocess.PIPE,
                stderr=subprocess.PIPE,
                timeout=20,
                check=False,
                env={"PATH": "/usr/local/sbin:/usr/local/bin:/usr/bin"},
            )
        except (OSError, subprocess.TimeoutExpired):
            self.status.set_text("RESET FAILED — RECOVERY HELPER UNAVAILABLE")
            self.password.set_text("")
            self.confirm.set_text("")
            return

        self.password.set_text("")
        self.confirm.set_text("")
        if completed.returncode == 0:
            self.status.set_text("PASSWORD UPDATED — RETURN TO SIGN-IN AND USE THE NEW PASSWORD")
        else:
            detail = completed.stderr.strip().splitlines()
            self.status.set_text(detail[-1] if detail else "PASSWORD RESET FAILED")

    def _leave_session(self, _widget: Gtk.Widget) -> None:
        try:
            subprocess.Popen(
                ["/usr/bin/hyprctl", "dispatch", "exit"],
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
                close_fds=True,
            )
        except OSError:
            Gtk.main_quit()


def main() -> int:
    if os.geteuid() == 0 or os.environ.get("USER") != RECOVERY_USER:
        print("SenomyOS recovery: invalid execution identity.", file=sys.stderr)
        return 77
    window = RecoveryWindow()
    window.show_all()
    window.fullscreen()
    window.password.grab_focus()
    Gtk.main()
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
