#!/usr/bin/env bash

set -euo pipefail
export LC_ALL=C
umask 077

readonly CONFIG=/etc/senomyos/recovery.conf
readonly EXPECTED_CALLER=senomy-recovery

fail() {
  printf 'RECOVERY ERROR: %s\n' "$*" >&2
  exit 1
}

[[ "$EUID" -eq 0 ]] || fail 'helper must run through the recovery sudo rule'
[[ "${SUDO_USER:-}" == "$EXPECTED_CALLER" ]] || fail 'invalid recovery caller'
[[ -f "$CONFIG" && ! -L "$CONFIG" ]] || fail 'recovery target is not provisioned'
[[ "$(stat -c %U:%G "$CONFIG")" == root:root ]] || fail 'recovery configuration owner is invalid'
[[ "$(stat -c %a "$CONFIG")" == 644 ]] || fail 'recovery configuration mode is invalid'

IFS= read -r target_line <"$CONFIG" || fail 'unable to read recovery target'
[[ "$target_line" =~ ^TARGET_USER=([A-Za-z_][A-Za-z0-9_.-]{0,31})$ ]] || fail 'recovery target is invalid'
readonly TARGET_USER="${BASH_REMATCH[1]}"

[[ "$TARGET_USER" != root && "$TARGET_USER" != "$EXPECTED_CALLER" ]] || fail 'refusing privileged recovery target'
passwd_record="$(getent passwd "$TARGET_USER" || true)"
[[ -n "$passwd_record" ]] || fail 'configured account does not exist'
IFS=: read -r _ _ target_uid _ _ _ target_shell <<<"$passwd_record"
[[ "$target_uid" =~ ^[0-9]+$ && "$target_uid" -ge 1000 ]] || fail 'configured account is not an ordinary user'
[[ "$target_shell" != */nologin && "$target_shell" != */false ]] || fail 'configured account cannot log in'

IFS= read -r new_password || fail 'new password was not supplied'
IFS= read -r confirmation || fail 'password confirmation was not supplied'

[[ "$new_password" == "$confirmation" ]] || fail 'passwords do not match'
[[ "${#new_password}" -ge 12 && "${#new_password}" -le 128 ]] || fail 'password must contain 12 to 128 characters'
[[ "$new_password" != *:* ]] || fail 'password cannot contain a colon in recovery mode'
[[ "${new_password,,}" != "${TARGET_USER,,}" ]] || fail 'password cannot equal the account name'

printf '%s:%s\n' "$TARGET_USER" "$new_password" | /usr/bin/chpasswd || fail 'system password update failed'
unset new_password confirmation
/usr/bin/logger --priority authpriv.notice --tag senomy-recovery "password reset completed for $TARGET_USER by authenticated recovery session"
printf 'PASSWORD UPDATED\n'
