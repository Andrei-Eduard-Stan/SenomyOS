#!/usr/bin/env bash

set -euo pipefail
export LC_ALL=C

readonly RECOVERY_USER="senomy-recovery"
readonly HYPRLAND_CONFIG="/etc/senomyos/recovery-hyprland.lua"

[[ "$(id -un)" == "$RECOVERY_USER" ]] || {
  printf 'SenomyOS recovery: this session is restricted to %s.\n' "$RECOVERY_USER" >&2
  exit 77
}

[[ -f "$HYPRLAND_CONFIG" && ! -L "$HYPRLAND_CONFIG" ]] || {
  printf 'SenomyOS recovery: compositor configuration is unavailable.\n' >&2
  exit 78
}

export XDG_SESSION_DESKTOP=SenomyRecovery
export XDG_CURRENT_DESKTOP=SenomyRecovery
export XDG_SESSION_TYPE=wayland
export GDK_BACKEND=wayland
export QT_QPA_PLATFORM=wayland

exec /usr/bin/Hyprland --config "$HYPRLAND_CONFIG"
