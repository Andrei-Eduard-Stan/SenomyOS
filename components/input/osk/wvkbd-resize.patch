+        x,y,keyboard.resize_width,keyboard.resize_height};
+    senomy_start_x=keyboard.resize_x;senomy_start_y=keyboard.resize_y;
+    wl_surface_set_input_region(draw_surf.surf,NULL);
+    wl_surface_commit(draw_surf.surf);
