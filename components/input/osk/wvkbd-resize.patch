+static bool senomy_begin(int x, int y, int touch_id, uint32_t time) {
+    if (!senomy_resize || !layer_surface_configured || senomy_drag.edge) return false;
+    int lx=x-(int)keyboard.resize_x,ly=y-(int)keyboard.resize_y;
+    if (ly>=0 && ly<SENOMY_EDGE && lx>=SENOMY_EDGE && lx<SENOMY_EDGE+100) {senomy_toggle_mode();return true;}
+    int edge = (ly>=0 && ly<SENOMY_EDGE && lx>=(int)keyboard.resize_width/2-48 && lx<=(int)keyboard.resize_width/2+48) ? 8 : senomy_edge(lx,ly,keyboard.resize_width,keyboard.resize_height);
+    if (!edge) return false;
