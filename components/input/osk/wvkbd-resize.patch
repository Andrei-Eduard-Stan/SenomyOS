+/* Optional SenomyOS edge resizing. No keys or surrounding text in telemetry. */
+static bool senomy_resize = false;
+static struct senomy_drag senomy_drag;
+static void senomy_geometry(bool visible) {
+    if (!senomy_resize) return;
+    printf("{\"event\":\"geometry\",\"visible\":%s,\"width\":%u,\"height\":%u}\n",
+           visible ? "true" : "false", visible ? keyboard.resize_width : 0, visible ? keyboard.resize_height : 0);
+    fflush(stdout);
+}
+static bool senomy_begin(int x, int y, int touch_id, uint32_t time) {
+    if (!senomy_resize || !layer_surface_configured || senomy_drag.edge) return false;
+    int edge = senomy_edge(x-(int)keyboard.resize_x,y-(int)keyboard.resize_y,keyboard.resize_width,keyboard.resize_height);
+    if (!edge) return false;
+    kbd_unpress_key(&keyboard,time);
+    senomy_drag = (struct senomy_drag){edge,touch_id,
+        x,y,keyboard.resize_width,keyboard.resize_height};
+    wl_surface_set_input_region(draw_surf.surf,NULL);
+    wl_surface_commit(draw_surf.surf);
+    return true;
+}
+static void senomy_input_region(void) {
+    if (!senomy_resize || !draw_surf.surf) return;
+    struct wl_region *region=wl_compositor_create_region(compositor);
+    wl_region_add(region,keyboard.resize_x,keyboard.resize_y,keyboard.resize_width,keyboard.resize_height);
+    wl_surface_set_input_region(draw_surf.surf,region);wl_region_destroy(region);
+    wl_surface_commit(draw_surf.surf);
+}
+static void senomy_motion(int x,int y) {
+    if (!senomy_drag.edge || !layer_surface) return;
+    uint32_t w,h;
+    senomy_size(&senomy_drag,x,y,keyboard.w,keyboard.h,&w,&h);
+    custom_width=w;
+    if (keyboard.landscape) landscape_height=h; else normal_height=h;
+    height=h;keyboard.resize_width=w;keyboard.resize_height=h;
+    keyboard.resize_x=(keyboard.w-w)/2;keyboard.resize_y=keyboard.h-h;
+    if (keyboard.exclusive) zwlr_layer_surface_v1_set_exclusive_zone(layer_surface,h);
+    kbd_resize(&keyboard,layouts,NumLayouts);drwsurf_attach(&draw_surf);
+    wl_surface_commit(draw_surf.surf);senomy_geometry(true);
+}
+
