+static void senomy_read_state(void) {
+    static char line[16];static unsigned used=0;static bool overflow=false;
+    char bytes[64];ssize_t n=read(STDIN_FILENO,bytes,sizeof(bytes));
+    for (ssize_t i=0;i<n;i++) {
