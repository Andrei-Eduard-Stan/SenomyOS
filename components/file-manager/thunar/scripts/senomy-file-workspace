#!/usr/bin/env bash

# Start the SenomyOS file workspace with the namespaced GTK theme when this
# invocation owns a fresh Thunar daemon. Existing Thunar sessions are reused
# without interruption and therefore keep the environment they started with.

set -euo pipefail
export LC_ALL="${LC_ALL:-C.UTF-8}"

fail() {
  printf 'senomy-file-workspace: %s\n' "$*" >&2
  exit 1
}

path_is_safe() {
  local path="$1"
  [[ "$path" == /* ]] || return 1
  [[ ! "$path" =~ [[:cntrl:]] ]] || return 1
  [[ -e "$path" || -L "$path" ]]
}

resolve_command() {
  command -v "$1" 2>/dev/null
}

readonly BASE_THEME_NAME="${SENOMY_GTK_THEME:-SenomyOS}"
REQUESTED_DENSITY="${SENOMY_FILE_DENSITY:-auto}"
case "$REQUESTED_DENSITY" in
  auto | standard | touch) ;;
  *) fail "The file-workspace density must be auto, standard, or touch." ;;
esac

if [[ "$REQUESTED_DENSITY" == auto ]]; then
  REQUESTED_DENSITY=standard
  PREFERENCES="${XDG_CONFIG_HOME:-${HOME:-/nonexistent}/.config}/senomyos/preferences.json"
  PROFILE="${XDG_CONFIG_HOME:-${HOME:-/nonexistent}/.config}/senomyos/profile.json"
  if [[ -f "$PROFILE" && ! -L "$PROFILE" ]] && command -v jq >/dev/null 2>&1; then
    [[ "$(jq -r '.file_manager.density // "standard"' "$PROFILE" 2>/dev/null || true)" == touch ]] &&
      REQUESTED_DENSITY=touch
  fi
  if [[ -f "$PREFERENCES" && ! -L "$PREFERENCES" ]] && command -v jq >/dev/null 2>&1; then
    [[ "$(jq -r '.font_scale // "standard"' "$PREFERENCES" 2>/dev/null || true)" == touch ]] &&
      REQUESTED_DENSITY=touch
  fi
fi

THEME_NAME="$BASE_THEME_NAME"
[[ "$REQUESTED_DENSITY" == touch ]] && THEME_NAME="${BASE_THEME_NAME}-Touch"
readonly THEME_NAME
readonly THEME_ROOT="${XDG_DATA_HOME:-${HOME:-/nonexistent}/.local/share}/themes/$THEME_NAME"
THUNAR_BIN="$(resolve_command "${SENOMY_THUNAR_BIN:-thunar}")" || fail "Thunar is not installed."
PGREP_BIN="$(resolve_command "${SENOMY_PGREP_BIN:-pgrep}" || true)"
SYSTEMD_RUN_BIN="$(resolve_command "${SENOMY_SYSTEMD_RUN_BIN:-systemd-run}" || true)"
NOHUP_BIN="$(resolve_command "${SENOMY_NOHUP_BIN:-nohup}" || true)"
XFCONF_BIN="$(resolve_command "${SENOMY_XFCONF_BIN:-xfconf-query}" || true)"
declare -a THUNAR_ARGS=()
MODE='open'
SELECTED_PATH=''
BUSCTL_BIN=''

[[ "$BASE_THEME_NAME" =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]] || fail "The GTK theme name is invalid."

case "$#:${1:-}" in
  0:*)
    [[ "${HOME:-}" == /* && -d "$HOME" ]] || fail "The home folder is unavailable."
    THUNAR_ARGS=(-- "$HOME")
    ;;
  2:--)
    path_is_safe "$2" || fail "The requested path must be an existing absolute local path."
    THUNAR_ARGS=(-- "$2")
    ;;
  2:--select)
    path_is_safe "$2" || fail "The selected path must be an existing absolute local path."
    MODE='select'
    SELECTED_PATH="$2"
    ;;
  *) fail "Only a home launch, -- PATH, or --select PATH is supported." ;;
esac

thunar_is_running() {
  [[ -n "$PGREP_BIN" ]] && "$PGREP_BIN" -i -x thunar >/dev/null 2>&1
}

theme_is_available() {
  [[ -f "$THEME_ROOT/gtk-3.0/gtk.css" && ! -L "$THEME_ROOT/gtk-3.0/gtk.css" ]]
}

normalize_sidebar_position() {
  local current preferred=220
  [[ -n "$XFCONF_BIN" ]] || return 0
  [[ "$REQUESTED_DENSITY" == touch ]] && preferred=260

  current="$("$XFCONF_BIN" -c thunar -p /last-separator-position 2>/dev/null || true)"
  if [[ "$current" =~ ^[0-9]+$ ]] && ((current >= 160 && current <= 280)); then
    return 0
  fi

  if [[ "$current" =~ ^[0-9]+$ ]]; then
    "$XFCONF_BIN" -c thunar -p /last-separator-position -s "$preferred" >/dev/null 2>&1 || true
  else
    "$XFCONF_BIN" -c thunar -p /last-separator-position -n -t int -s "$preferred" >/dev/null 2>&1 || true
  fi
}

set_xfconf_string() {
  local property="$1" expected="$2" current
  [[ -n "$XFCONF_BIN" ]] || return 0

  current="$("$XFCONF_BIN" -c thunar -p "$property" 2>/dev/null || true)"
  [[ "$current" == "$expected" ]] && return 0
  if [[ -n "$current" ]]; then
    "$XFCONF_BIN" -c thunar -p "$property" -s "$expected" >/dev/null 2>&1 || true
  else
    "$XFCONF_BIN" -c thunar -p "$property" -n -t string -s "$expected" >/dev/null 2>&1 || true
  fi
}

normalize_workspace_layout() {
  # The visual target uses Thunar's real categorized Shortcuts inventory on
  # the left and its native standalone image preview on the right. Both remain
  # user-toggleable after launch; this only establishes the scoped fresh-daemon
  # composition and never mutates an already-running session.
  set_xfconf_string /last-side-pane THUNAR_SIDEPANE_TYPE_SHORTCUTS
  set_xfconf_string /misc-image-preview-mode THUNAR_IMAGE_PREVIEW_MODE_STANDALONE
}

resolve_busctl() {
  [[ -n "$BUSCTL_BIN" ]] && return 0
  BUSCTL_BIN="$(resolve_command "${SENOMY_BUSCTL_BIN:-busctl}")" || fail "Starting Thunar requires busctl."
}

start_thunar_daemon() {
  if theme_is_available; then
    if [[ -n "$SYSTEMD_RUN_BIN" ]] &&
       "$SYSTEMD_RUN_BIN" --user --quiet --collect \
         "--setenv=GTK_THEME=$THEME_NAME" "$THUNAR_BIN" --daemon >/dev/null 2>&1; then
      return 0
    fi
    [[ -n "$NOHUP_BIN" ]] || fail "A detached Thunar daemon requires systemd-run or nohup."
    GTK_THEME="$THEME_NAME" "$NOHUP_BIN" "$THUNAR_BIN" --daemon </dev/null >/dev/null 2>&1 &
  else
    printf 'senomy-file-workspace: theme %s is unavailable; opening native Thunar.\n' "$THEME_NAME" >&2
    if [[ -n "$SYSTEMD_RUN_BIN" ]] &&
       "$SYSTEMD_RUN_BIN" --user --quiet --collect "$THUNAR_BIN" --daemon >/dev/null 2>&1; then
      return 0
    fi
    [[ -n "$NOHUP_BIN" ]] || fail "A detached Thunar daemon requires systemd-run or nohup."
    "$NOHUP_BIN" "$THUNAR_BIN" --daemon </dev/null >/dev/null 2>&1 &
  fi
}

if [[ "$MODE" == select ]]; then
  resolve_busctl
fi

if ! thunar_is_running; then
  normalize_sidebar_position
  normalize_workspace_layout
  resolve_busctl
  start_thunar_daemon
fi

if [[ -n "$BUSCTL_BIN" ]]; then
  service_ready=false
  for attempt in {1..50}; do
    if "$BUSCTL_BIN" --user list --no-legend 2>/dev/null |
       awk '$1 == "org.xfce.Thunar" && $2 ~ /^[1-9][0-9]*$/ { found=1 } END { exit !found }'; then
      service_ready=true
      break
    fi
    sleep 0.1
  done
  [[ "$service_ready" == true ]] || fail "Thunar did not expose its file-manager interface."
fi

if [[ "$MODE" == open ]]; then
  exec "$THUNAR_BIN" --window "${THUNAR_ARGS[@]}"
fi

resolve_busctl
GIO_BIN="$(resolve_command "${SENOMY_GIO_BIN:-gio}")" || fail "File selection requires GIO."
SELECTED_URI="$("$GIO_BIN" info -a standard::target-uri -- "$SELECTED_PATH" 2>/dev/null | sed -n 's/^uri: //p' | head -n 1)"
[[ "$SELECTED_URI" == file://* && ! "$SELECTED_URI" =~ [[:cntrl:]] ]] || fail "The selected path URI could not be resolved safely."

"$BUSCTL_BIN" --user call \
  org.xfce.Thunar \
  /org/freedesktop/FileManager1 \
  org.freedesktop.FileManager1 \
  ShowItems ass 1 "$SELECTED_URI" '' >/dev/null || fail "Thunar could not reveal the selected item."

exit 0
