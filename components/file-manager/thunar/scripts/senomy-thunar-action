#!/usr/bin/env bash

# Fixed, data-only actions invoked by Thunar UCA entries. Thunar expands %F
# into individually quoted arguments; this helper never evaluates those values.
set -euo pipefail

action="${1:-}"
[[ $# -gt 0 ]] && shift

notify() {
  local title="$1" detail="$2"
  if command -v notify-send >/dev/null 2>&1; then
    notify-send --app-name=SenomyOS "$title" "$detail" >/dev/null 2>&1 || true
  fi
}

fail_action() {
  notify "Thunar action unavailable" "$1"
  printf 'senomy-thunar-action: %s\n' "$1" >&2
  exit 1
}

validate_paths() {
  local maximum="$1" require_files="$2" path
  shift 2
  (($# > 0)) || fail_action "No selected paths were provided."
  (($# <= maximum)) || fail_action "The selection exceeds the $maximum-item safety limit."
  for path in "$@"; do
    [[ "$path" == /* ]] || fail_action "Only absolute local paths are supported."
    [[ ! "$path" =~ [[:cntrl:]] ]] || fail_action "Paths containing control characters are not supported."
    [[ -e "$path" || -L "$path" ]] || fail_action "A selected path no longer exists."
    if [[ "$require_files" == true && ! -f "$path" ]]; then
      fail_action "Checksum calculation accepts regular files only."
    fi
  done
}

case "$action" in
  copy-path)
    validate_paths 100 false "$@"
    command -v wl-copy >/dev/null 2>&1 || fail_action "wl-copy is not installed."
    printf '%s\n' "$@" | wl-copy || fail_action "The path clipboard operation failed."
    notify "Path copied" "$# item(s) copied to the clipboard."
    ;;
  copy-sha256)
    validate_paths 32 true "$@"
    command -v sha256sum >/dev/null 2>&1 || fail_action "sha256sum is not installed."
    command -v wl-copy >/dev/null 2>&1 || fail_action "wl-copy is not installed."
    result="$(timeout 30s sha256sum -- "$@")" || fail_action "Checksum calculation failed or exceeded 30 seconds; the clipboard was not changed."
    printf '%s\n' "$result" | wl-copy || fail_action "The checksum clipboard operation failed."
    notify "SHA-256 copied" "$# checksum(s) copied to the clipboard."
    ;;
  copy-name)
    validate_paths 100 false "$@"
    command -v wl-copy >/dev/null 2>&1 || fail_action "wl-copy is not installed."
    for path in "$@"; do basename -- "$path"; done |
      wl-copy || fail_action "The name clipboard operation failed."
    notify "Names copied" "$# filename(s) copied to the clipboard."
    ;;
  copy-uri | copy-project-path)
    validate_paths 100 false "$@"
    command -v python3 >/dev/null 2>&1 || fail_action "Python 3 is not installed."
    command -v wl-copy >/dev/null 2>&1 || fail_action "wl-copy is not installed."
    result="$(python3 - "$action" "$@" <<'PYCODE'
from pathlib import Path
import sys
mode,*items=sys.argv[1:]
if mode == "copy-uri":
    result=[Path(item).as_uri() for item in items]
else:
    result=[]
    project=None
    for item in items:
        path=Path(item)
        start=path if path.is_dir() else path.parent
        root=next((parent for parent in [start,*start.parents][:64]
                   if (parent/".git").exists() or (parent/".hg").is_dir()),None)
        if root is None:
            sys.exit("A selected item is outside a Git or Mercurial workspace.")
        if project is not None and root != project:
            sys.exit("Select items within one workspace to copy project-relative paths.")
        project=root
        result.append(str(path.relative_to(root)))
print("\n".join(result))
PYCODE
)" || fail_action "Could not prepare paths; select local files in one workspace for project paths. The clipboard was not changed."
    printf '%s\n' "$result" | wl-copy || fail_action "The path clipboard operation failed."
    notify "Paths copied" "$# item(s) copied to the clipboard."
    ;;
  *) fail_action "Unknown allowlisted action." ;;
esac
