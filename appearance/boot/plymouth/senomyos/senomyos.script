# SenomyOS Plymouth script theme. This source is staged but not activated.

Window.SetBackgroundTopColor(0.031, 0.035, 0.043);
Window.SetBackgroundBottomColor(0.039, 0.047, 0.059);

logo.image = Image("logo.png");
logo.sprite = Sprite(logo.image);
logo.sprite.SetX(Window.GetWidth() / 2 - logo.image.GetWidth() / 2);
logo.sprite.SetY(Window.GetHeight() * 0.27 - logo.image.GetHeight() / 2);

title.image = Image.Text("SENOMY //", 0.71, 0.68, 0.95);
title.sprite = Sprite(title.image);
title.sprite.SetX(Window.GetWidth() / 2 - title.image.GetWidth() / 2);
title.sprite.SetY(Window.GetHeight() * 0.43 - title.image.GetHeight() / 2);

status.image = Image.Text("SYSTEM STARTING", 0.57, 0.58, 0.62);
status.sprite = Sprite(status.image);
status.sprite.SetX(Window.GetWidth() / 2 - status.image.GetWidth() / 2);
status.sprite.SetY(Window.GetHeight() * 0.54 - status.image.GetHeight() / 2);

progress.image = Image.Text("────────────", 0.40, 0.38, 0.73);
progress.sprite = Sprite(progress.image);
progress.sprite.SetX(Window.GetWidth() / 2 - progress.image.GetWidth() / 2);
progress.sprite.SetY(Window.GetHeight() * 0.59 - progress.image.GetHeight() / 2);

fun message_callback(text) {
    status.image = Image.Text(text, 0.57, 0.58, 0.62);
    status.sprite.SetImage(status.image);
    status.sprite.SetX(Window.GetWidth() / 2 - status.image.GetWidth() / 2);
}

Plymouth.SetMessageFunction(message_callback);
