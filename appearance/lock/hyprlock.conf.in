# SenomyOS Luminous Reliquary lock surface.
# The five 170px instruments use exact Compact-tier Rail frame projections and
# the Rail's 22px inter-island rhythm. Utility marks remain non-interactive.

general {
    hide_cursor = false
    ignore_empty_input = true
    immediate_render = true
    fail_timeout = 1800
}

auth {
    pam:enabled = true
    pam:module = hyprlock
    fingerprint:enabled = false
}

animations {
    enabled = true
    bezier = senomyFast, 0.15, 0, 0.1, 1
    animation = fade, 1, 2.0, senomyFast
    animation = inputField, 1, 1.8, senomyFast
}

background {
    monitor =
    path = screenshot
    color = @BACKGROUND@
    blur_passes = 4
    blur_size = 8
    noise = 0.003
    contrast = 0.92
    brightness = 0.72
    vibrancy = 0.10
    vibrancy_darkness = 0.0
    zindex = -2
}

shape {
    monitor =
    size = 100%, 100%
    color = rgba(8, 9, 11, 0.32)
    rounding = 0
    position = 0, 0
    halign = center
    valign = center
    zindex = -1
}

# Exact 1920px Rail grid: 32px outer inset, 22px gaps, 170px optical height.
# Widths: 408 + 284 + 654 + 202 + 220 = 1768px; gaps add 88px.
image {
    monitor =
    path = $XDG_DATA_HOME/senomyos/appearance/frames/lock-utility.png
    size = 170
    rounding = 0
    border_size = 0
    position = -724, 32
    halign = center
    valign = bottom
    zindex = 10
}

image {
    monitor =
    path = $XDG_DATA_HOME/senomyos/appearance/frames/lock-identity.png
    size = 170
    rounding = 0
    border_size = 0
    position = -356, 32
    halign = center
    valign = bottom
    zindex = 10
}

image {
    monitor =
    path = $XDG_DATA_HOME/senomyos/appearance/frames/lock-authentication.png
    size = 170
    rounding = 0
    border_size = 0
    position = 135, 32
    halign = center
    valign = bottom
    zindex = 10
}

image {
    monitor =
    path = $XDG_DATA_HOME/senomyos/appearance/frames/lock-session.png
    size = 170
    rounding = 0
    border_size = 0
    position = 585, 32
    halign = center
    valign = bottom
    zindex = 10
}

image {
    monitor =
    path = $XDG_DATA_HOME/senomyos/appearance/frames/lock-clock.png
    size = 170
    rounding = 0
    border_size = 0
    position = 818, 32
    halign = center
    valign = bottom
    zindex = 10
}

