# Authentication instrument. Hyprlock owns the PAM field; Enter is the only
# adjacent action and no pre-unlock command is exposed.
label {
    monitor =
    text = PASSWORD
    color = @MUTED@
    font_size = 11
    font_family = @FONT@
    position = -126, 156
    halign = center
    valign = bottom
    zindex = 12
}

input-field {
    monitor =
    size = 430, 54
    outline_thickness = 1
    dots_size = 0.26
    dots_spacing = 0.20
    dots_center = false
    dots_rounding = -1
    outer_color = rgba(221, 224, 234, 0.58)
    inner_color = @SURFACE_RAISED@
    font_color = @FOREGROUND@
    font_family = @FONT@
    fade_on_empty = false
    placeholder_text = <span foreground="##92959f">TYPE YOUR PASSWORD</span>
    hide_input = false
    rounding = 4
    check_color = @ACCENT@
    check_text = AUTHENTICATING
    fail_color = @DANGER@
    fail_text = $FAIL <b>[$ATTEMPTS]</b>
    capslock_color = @WARNING@
    position = 48, 86
    halign = center
    valign = bottom
    zindex = 12
}

shape {
    monitor =
    size = 156, 54
    color = @ACCENT@
    rounding = 4
    position = 359, 86
    halign = center
    valign = bottom
    zindex = 12
}

label {
    monitor =
    text = PRESS ENTER
    color = @BACKGROUND@
    font_size = 12
    font_family = @FONT@
    position = 351, 86
    halign = center
    valign = bottom
    zindex = 13
}

