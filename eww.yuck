;;Include windgets --

(include "widgets/workspace-widget.yuck")
(include "widgets/system-widget.yuck")
(include "widgets/volume-widget.yuck")
(include "widgets/wifi-widget.yuck")
(include "widgets/battery-widget.yuck")
(include "widgets/clock-widget.yuck")
(include "widgets/senomy-status.yuck")
(include "widgets/system-tray.yuck")

; Include section content --

(include "sections/insights/briefing.yuck")
(include "sections/insights/timeline.yuck")
(include "sections/insights/updates.yuck")
(include "sections/insights/diagnostics.yuck")
(include "sections/insights/reports.yuck")
(include "sections/control/applications.yuck")

; Include windows --

(include "windows/clock-panel.yuck")
(include "windows/actioncenter-panel.yuck")
(include "windows/insights-panel.yuck")
(include "windows/main-bar.yuck")

; Variables --
(defvar workspaces "")
(defvar workspace_state "{\"schema_version\":1,\"ok\":false,\"source\":\"initial\",\"observed_at\":0,\"data\":{\"active_id\":0,\"max_id\":0,\"workspaces\":[]},\"error\":{\"code\":\"loading\",\"message\":\"Workspace state is loading\"}}")
(defvar active_surface "none") ; none|control|performance|insights
(defvar control_section "overview") ; overview|network|audio|power|calendar|input|devices|apps|settings
(defvar insights_section "briefing") ; briefing|timeline|updates|diagnostics|reports
(defvar timeline_source "user") ; user|system|kernel|eww
(defvar timeline_follow true)
(defvar chibi_state "idle")
(defvar pending_action "none")

(defpoll time :interval "60s" "date +%H:%M")
(defpoll date :interval "60s" "date '+%a, %d %b'")
(defpoll batt_json
  :interval "10s"
  :initial "{\"dual\":false,\"bat0_percent\":0,\"bat0_icon\":\"\",\"bat1_percent\":0,\"bat1_icon\":\"\",\"percent_total\":0,\"total_icon\":\"\",\"state\":\"loading\"}"
  "~/.config/eww/scripts/battery.sh")
(defpoll system_status :interval "2s" :initial "{}" "$HOME/.config/eww/scripts/system-status.sh")
(defpoll senomy_ambient
  :interval "15m"
  :initial "{\"schema_version\":1,\"ok\":true,\"source\":\"initial\",\"observed_at\":0,\"data\":{\"id\":\"ambient-initial\",\"category\":\"ambient\",\"severity\":\"ambient\",\"rarity\":\"common\",\"language\":\"en\",\"tone\":\"calm\",\"text\":\"Everything looks steady.\"},\"error\":null}"
  "$HOME/.config/eww/scripts/senomy-dialogue.sh ambient")
(defpoll timeline_user_status
  :interval "5s"
  :run-while {active_surface == "insights" && insights_section == "timeline" && timeline_source == "user" && timeline_follow}
  :initial "{\"schema_version\":1,\"ok\":true,\"source\":\"initial\",\"observed_at\":0,\"data\":{\"mode\":\"user\",\"limit\":40,\"count\":0,\"entries\":[]},\"error\":null}"
  "$HOME/.config/eww/scripts/timeline-status.sh user")
(defpoll timeline_system_status
  :interval "5s"
  :run-while {active_surface == "insights" && insights_section == "timeline" && timeline_source == "system" && timeline_follow}
  :initial "{\"schema_version\":1,\"ok\":true,\"source\":\"initial\",\"observed_at\":0,\"data\":{\"mode\":\"system\",\"limit\":40,\"count\":0,\"entries\":[]},\"error\":null}"
  "$HOME/.config/eww/scripts/timeline-status.sh system")
(defpoll timeline_kernel_status
  :interval "5s"
  :run-while {active_surface == "insights" && insights_section == "timeline" && timeline_source == "kernel" && timeline_follow}
  :initial "{\"schema_version\":1,\"ok\":true,\"source\":\"initial\",\"observed_at\":0,\"data\":{\"mode\":\"kernel\",\"limit\":40,\"count\":0,\"entries\":[]},\"error\":null}"
  "$HOME/.config/eww/scripts/timeline-status.sh kernel")
(defpoll timeline_eww_status
  :interval "5s"
  :run-while {active_surface == "insights" && insights_section == "timeline" && timeline_source == "eww" && timeline_follow}
  :initial "{\"schema_version\":1,\"ok\":true,\"source\":\"initial\",\"observed_at\":0,\"data\":{\"mode\":\"eww\",\"limit\":40,\"count\":0,\"entries\":[]},\"error\":null}"
  "$HOME/.config/eww/scripts/timeline-status.sh eww")
(defpoll updates_status
  :interval "2s"
  :run-while {active_surface == "insights" && insights_section == "updates"}
  :initial "{\"schema_version\":1,\"ok\":true,\"source\":\"initial\",\"observed_at\":0,\"data\":{\"state\":\"never_checked\",\"active_check\":\"none\",\"known_total_count\":0,\"successful_source_count\":0,\"last_attempt_at\":0,\"last_attempt_label\":\"NEVER\",\"official\":{\"state\":\"never_checked\",\"state_label\":\"NOT CHECKED\",\"ok\":false,\"source\":\"none\",\"freshness\":\"unknown\",\"checked_at\":0,\"checked_at_label\":\"NEVER\",\"count\":0,\"shown_count\":0,\"truncated\":false,\"packages\":[],\"warning\":\"Without checkupdates, the fallback reads pacman local databases and may be stale.\",\"error\":null},\"aur\":{\"state\":\"never_checked\",\"state_label\":\"NOT CHECKED\",\"ok\":false,\"source\":\"none\",\"freshness\":\"unknown\",\"checked_at\":0,\"checked_at_label\":\"NEVER\",\"count\":0,\"shown_count\":0,\"truncated\":false,\"packages\":[],\"warning\":\"An AUR check queries aur.archlinux.org with installed foreign package names.\",\"error\":null}},\"error\":null}"
  "$HOME/.config/eww/scripts/update-status.sh read")
(defpoll diagnostics_catalog
  :interval "1h"
  :run-while {active_surface == "insights" && insights_section == "diagnostics"}
  :initial "{\"schema_version\":1,\"ok\":true,\"source\":\"initial\",\"observed_at\":0,\"data\":{\"tasks\":[]},\"error\":null}"
  "$HOME/.config/eww/scripts/diagnostics-status.sh catalog")
(defpoll diagnostics_status
  :interval "1s"
  :run-while {active_surface == "insights" && insights_section == "diagnostics"}
  :initial "{\"schema_version\":1,\"ok\":true,\"source\":\"initial\",\"observed_at\":0,\"data\":{\"state\":\"idle\",\"state_label\":\"READY\",\"active_task\":\"none\",\"task_id\":\"none\",\"code\":\"RUN\",\"title\":\"Awaiting task\",\"category\":\"policy\",\"summary\":\"Six read-only tasks are available.\",\"command_preview\":\"select <allowlisted-task>\",\"execution_source\":\"senomy-diagnostics\",\"scope\":\"No command has run.\",\"guidance\":\"Choose a task above. Arbitrary commands belong in a real terminal.\",\"started_at\":0,\"started_at_label\":\"NEVER\",\"finished_at\":0,\"finished_at_label\":\"NEVER\",\"duration_ms\":0,\"exit_code\":null,\"line_count\":0,\"shown_line_count\":0,\"truncated\":false,\"output\":[]},\"error\":null}"
  "$HOME/.config/eww/scripts/diagnostics-status.sh read")
(defpoll background_apps_status
  :interval "2s"
  :run-while {active_surface == "control" && control_section == "apps"}
  :initial "{\"schema_version\":1,\"ok\":true,\"source\":\"initial\",\"observed_at\":0,\"data\":{\"tray\":{\"host_available\":false,\"registered_count\":0,\"registered_ids\":[]},\"app_count\":0,\"running_count\":0,\"apps\":[]},\"error\":null}"
  "$HOME/.config/eww/scripts/background-apps-status.sh")
