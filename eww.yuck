(include "widgets/wifi-widget.yuck")
(include "widgets/battery-widget.yuck")
(include "widgets/clock-widget.yuck")
(include "widgets/senomy-status.yuck")
(include "widgets/system-tray.yuck")
(include "widgets/performance-components.yuck")

; Include section content --

(include "sections/insights/briefing.yuck")
(include "sections/insights/notifications.yuck")
(include "sections/insights/timeline.yuck")
(include "sections/insights/updates.yuck")
