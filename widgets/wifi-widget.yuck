(defwidget wifi-button []
  (button
    :class "icon-button mainbar-wifi-button"
    :tooltip "Network controls"
    :timeout "2s"
    :onclick {active_surface == "control"
      ? (control_section == "network"
        ? "eww update active_surface=none; eww close actioncenter"
        : "eww update control_section=network")
      : "eww update active_surface=control control_section=network; eww open actioncenter"}
    ""))
