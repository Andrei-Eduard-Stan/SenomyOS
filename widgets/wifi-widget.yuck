(defwidget wifi-button []
  (button
    :class "icon-button mainbar-wifi-button"
    :tooltip "Network controls"
    :timeout "2s"
    :onclick {active_surface == "control"
      ? (control_section == "network"
        ? "${EWW_CMD} update active_surface=none; ${EWW_CMD} close actioncenter"
        : "${EWW_CMD} update control_section=network")
      : "${EWW_CMD} update active_surface=control control_section=network; ${EWW_CMD} open actioncenter"}
    ""))
