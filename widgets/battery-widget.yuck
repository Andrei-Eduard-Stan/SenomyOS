(defwidget battery-button []
  (button
    :class "icon-button battery-control"
    :tooltip "Power and battery details"
    :timeout "2s"
    :onclick {active_surface == "control"
      ? (control_section == "power"
        ? "${EWW_CMD} update active_surface=none; ${EWW_CMD} close actioncenter"
        : "${EWW_CMD} update control_section=power")
      : "${EWW_CMD} update active_surface=control control_section=power; ${EWW_CMD} open actioncenter"}

    (box :class "battery" :orientation "h" :space-evenly false
      ;; total battery
      (label :text "${batt_json.total_icon} ${batt_json.percent_total}% ")
      ;; dual section
      (box :class "dual" :visible {batt_json.dual}
        (label :text "${batt_json.bat0_icon}[0]${batt_json.bat0_percent}% ")
        (label :text "${batt_json.bat1_icon}[1]${batt_json.bat1_percent}% ")))))
