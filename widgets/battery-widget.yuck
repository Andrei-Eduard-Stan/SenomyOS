(defwidget battery-button []
  (button
    :class {active_surface == "control" && control_section == "power"
      ? "icon-button bar-control battery-control active"
      : (batt_json.available == true && batt_json.percent_total <= 20 && batt_json.state != "charging"
        ? "icon-button bar-control battery-control low"
        : (batt_json.state == "charging"
          ? "icon-button bar-control battery-control charging"
          : "icon-button bar-control battery-control"))}
    :tooltip {batt_json.state == "loading"
      ? "Battery status is loading"
      : (batt_json.available != true
        ? (batt_json.error ?: "No battery detected")
        : (batt_json.dual
      ? "Combined ${batt_json.percent_total}% / BAT0 ${batt_json.bat0_percent}% / BAT1 ${batt_json.bat1_percent}%"
      : "Battery ${batt_json.percent_total}% / ${batt_json.state}"))}
    :timeout "8s"
    :onclick "$HOME/.config/eww/scripts/surface-state.sh toggle-control power ${active_surface} ${active_flyout} ${control_section}"

    (box
      :class "battery-summary"
      :orientation "h"
      :halign "center"
      :valign "center"
      :space-evenly false
      :spacing 5
      (bar-icon
        :icon {batt_json.available != true
          ? "battery-50"
          : (batt_json.percent_total <= 20 && batt_json.state != "charging"
          ? "battery-low"
          : (batt_json.state == "charging"
          ? "battery-charging"
          : (batt_json.percent_total >= 88
            ? "battery-100"
            : (batt_json.percent_total >= 63
              ? "battery-75"
              : (batt_json.percent_total >= 38
                ? "battery-50"
                : "battery-25")))))})
      (label
        :class "battery-percent"
        :visible {bar_layout?.data?.phone != true}
        :halign "center"
        :valign "center"
        :xalign 0.5
        :yalign 0.5
        :text {batt_json.available == true ? "${batt_json.percent_total}%" : "--%"}))))
