(defwidget system-summary []
  (box
    :class "system-summary"
    :orientation "h"
    :spacing 10
    :space-evenly false
    :tooltip {system_status?.ok == true
      ? "Performance Dashboard coming next"
      : (system_status?.error?.message ?: "System status loading")}

    (label
      :text {system_status?.ok == true
        ? "CPU ${round(system_status.data.cpu.percent, 0)}%"
        : "CPU --"})

    (label
      :text {system_status?.ok == true
        ? "MEM ${round(system_status.data.memory.percent, 0)}%"
        : "MEM --"})

    (label
      :text {system_status?.ok == true
        ? "UP ${system_status.data.uptime.human}"
        : "UP --"})))