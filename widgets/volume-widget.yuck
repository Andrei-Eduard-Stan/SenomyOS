(defwidget volume-button []
  (button
    :class "icon-button"
    :tooltip "Audio controls"
    :timeout "2s"
    :onclick {active_surface == "control"
      ? (control_section == "audio"
        ? "eww update active_surface=none; eww close actioncenter"
        : "eww update control_section=audio")
      : "eww update active_surface=control control_section=audio; eww open actioncenter"}
    ""))
