(defwidget volume-button []
  (button
    :class {active_surface == "control" && control_section == "audio"
      ? "icon-button bar-control active"
      : "icon-button bar-control"}
    :tooltip "Audio controls"
    :timeout "2s"
    :onclick "$HOME/.config/eww/scripts/surface-state.sh toggle-control audio"
    ""))
