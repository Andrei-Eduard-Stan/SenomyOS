(defwidget volume-button []
  (button
    :class "icon-button"
    :tooltip "Audio controls"
    :timeout "2s"
    :onclick {active_surface == "control"
      ? (control_section == "audio"
        ? "${EWW_CMD} update active_surface=none; ${EWW_CMD} close actioncenter"
        : "${EWW_CMD} update control_section=audio")
      : "${EWW_CMD} update active_surface=control control_section=audio; ${EWW_CMD} open actioncenter"}
    ""))
