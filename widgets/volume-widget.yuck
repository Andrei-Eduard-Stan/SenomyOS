(defwidget volume-button []
  (button
    :class "icon-button"
    :tooltip "Audio controls"
    :onclick "if [ \"$(eww get active_surface)\" = control ] && [ \"$(eww get control_section)\" = audio ]; then eww update active_surface=none; else eww update active_surface=control control_section=audio; eww open actioncenter >/dev/null 2>&1 || true; fi"
    ""))