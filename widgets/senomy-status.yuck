(defwidget senomy-status []
  (box
    :class "senomy-identity-group"
    :space-evenly false

    (button
      :class {companion_mode != "closed"
        ? "senomy-companion-trigger active"
        : "senomy-companion-trigger"}
      :tooltip {companion_mode == "closed"
        ? "Open Senomy companion"
        : "Close Senomy companion"}
      :timeout "8s"
      :onclick "$HOME/.config/eww/scripts/companion-state.sh toggle"
      (senomy-avatar
        :variant "chibi"
        :size 24
        :context "bar"
        :domain "companion"))

    (button
      :visible {bar_layout?.data?.phone != true}
      :class {active_surface == "insights"
        ? "senomy-trigger bar-control active"
        : "senomy-trigger bar-control"}
      :tooltip {batt_json.state == "loading"
        ? "Battery status is loading"
        : (batt_json.available != true
          ? "Open Senomy Insights"
          : (batt_json.percent_total <= 10
          ? "Combined battery is ${batt_json.percent_total}% and requires attention"
          : (batt_json.percent_total <= 20
            ? "Combined battery is ${batt_json.percent_total}% and discharging"
            : (rail_system_status?.ok == true
              ? "Open Senomy Insights"
              : (rail_system_status?.error?.message ?: "System status is loading"))))) }
      :timeout "8s"
      :onclick "$HOME/.config/eww/scripts/surface-state.sh toggle-insights ${active_surface} ${active_flyout} ${insights_section}"

      (box
        :class "senomy-copy"
        :space-evenly false
        :spacing 6
        (label
          :class "senomy-speaker"
          :xalign 0
          :text "Seno:")
        (label
          :class {batt_json.available == true && batt_json.percent_total <= 10
            ? "senomy-dialogue critical"
            : (batt_json.available == true && batt_json.percent_total <= 20
              ? "senomy-dialogue warning"
              : "senomy-dialogue")}
          :xalign 0
          :limit-width {bar_layout?.data?.narrow == true ? 26 : (bar_layout?.data?.compact == true ? 40 : 52)}
          :show-truncated false
          :text {senomy_rail_message})))))
