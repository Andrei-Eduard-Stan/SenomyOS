--- a/shell/quickshell/services/InputSettings.qml
+++ b/shell/quickshell/services/InputSettings.qml
@@ -20,0 +21,58 @@
+    property bool editorAvailable: false
+    property bool engineInstalled: false
+    property bool nativeToolsBusy: false
+    property string nativeToolsMessage: ""
+    property string nativeToolsState: "idle"
+    function refreshNativeTools() {
+        if (!toolsQuery.running) toolsQuery.running = true;
+    }
+    function openInputMethodSettings() {
+        if (nativeToolsBusy || !editorAvailable) return false;
+        nativeToolsBusy = true;
+        nativeToolsState = "running";
+        nativeToolsMessage = "Starting Fcitx5 settings…";
+        toolsLaunch.running = true;
+        return true;
+    }
+    Process {
+        id: toolsQuery
+        command: ["python3", Quickshell.shellDir + "/scripts/native-input-tools.py", "detect"]
+        stdout: StdioCollector {
+            onStreamFinished: {
+                try {
+                    const result = JSON.parse(text);
+                    root.editorAvailable = result.ok === true && result.editorAvailable === true;
+                    root.engineInstalled = result.ok === true && result.engineInstalled === true;
+                } catch (error) {
+                    root.editorAvailable = false; root.engineInstalled = false;
+                    root.nativeToolsMessage = "Input-tool detection failed.";
+                }
+            }
+        }
+        onExited: (code, status) => {
+            if (code !== 0) { root.editorAvailable = false; root.engineInstalled = false; root.nativeToolsMessage = "Input-tool detection failed."; }
+        }
+    }
+    Process {
+        id: toolsLaunch
+        command: ["python3", Quickshell.shellDir + "/scripts/native-input-tools.py", "open-ime"]
+        stdout: StdioCollector {
+            onStreamFinished: {
+                try {
+                    const result = JSON.parse(text);
+                    root.nativeToolsState = result.state || "failed";
+                    root.nativeToolsMessage = result.message || "Input-tool launch failed.";
+                    if (result.state === "unavailable") root.editorAvailable = false;
+                } catch (error) {
+                    root.nativeToolsState = "failed"; root.nativeToolsMessage = "Input-tool launch returned invalid data.";
+                }
+            }
+        }
+        onExited: (code, status) => {
+            root.nativeToolsBusy = false;
+            if (root.nativeToolsState === "running") {
+                root.nativeToolsState = "failed";
+                root.nativeToolsMessage = "Input-tool launch did not return a result.";
+            }
+        }
+    }
@@ -34 +92 @@
-    onActiveChanged: if(active) refresh()
+    onActiveChanged: if(active) { refresh(); refreshNativeTools(); }
