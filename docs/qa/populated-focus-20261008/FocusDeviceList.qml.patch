--- a/shell/quickshell/components/FocusDeviceList.qml
+++ b/shell/quickshell/components/FocusDeviceList.qml
@@ -0,0 +1,17 @@
+import QtQuick
+
+// Device controls stay in Tab order even below the clipped viewport.
+// Provider inventories are finite; a Repeater avoids ListView virtualization
+// silently removing offscreen controls from keyboard traversal.
+FocusScrollArea {
+    id: root
+    property alias model: rows.model
+    property alias delegate: rows.delegate
+    property alias spacing: column.spacing
+    contentHeight: column.implicitHeight
+    Column {
+        id: column
+        width: root.width
+        Repeater { id: rows }
+    }
+}
