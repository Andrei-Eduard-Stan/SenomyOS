(defwidget volume-flyout-content []
  (box
    :class "volume-flyout-content"
    :orientation {bar_layout?.data?.narrow ? "v" : "h"}
    :valign "center"
    :space-evenly false
    :spacing 8

    (button
      :class {audio_status?.data?.output?.muted == true
        ? "volume-mute active"
        : "volume-mute"}
      :tooltip {audio_status?.data?.output?.muted == true
        ? "Unmute audio"
        : "Mute audio"}
      :timeout "2s"
      :active {audio_status?.ok == true && audio_status?.data?.available == true}
      :onclick "$HOME/.config/eww/scripts/volume.sh toggle-mute"
      (label
        :class "volume-mute-icon"
        :text {audio_status?.data?.output?.muted == true ? "󰝟" : ""}))

    (box
      :class "volume-slider-stack"
      :orientation "v"
      :space-evenly false
      :hexpand true
      :spacing 8

      (box
        :class "volume-flyout-meta"
        :space-evenly false
        (label
          :class "volume-flyout-device"
          :xalign 0
          :hexpand true
          :limit-width 28
          :show-truncated true
          :text {audio_status?.ok == true
            ? (audio_status?.data?.degraded == true
              ? "No physical output"
              : (audio_status?.data?.output?.name ?: "Default output"))
            : "Audio unavailable"})
        (label
          :class "volume-flyout-value"
          :text {audio_status?.ok == true
            ? "${round(audio_status?.data?.output?.volume_percent ?: 0, 0)}%"
            : "--%"}))

      (scale
        :class "volume-scale"
        :orientation "h"
        :min 0
        :max 100
        :value {audio_status?.data?.output?.volume_percent ?: 0}
        :active {audio_status?.ok == true && audio_status?.data?.available == true}
        :draw-value false
        :round-digits 0
        :timeout "80ms"
        :onchange "$HOME/.config/eww/scripts/volume.sh set {}"))

    (button
      :class "volume-open-audio"
      :tooltip "Open the Audio section in Control Centre"
      :timeout "8s"
      :onclick "$HOME/.config/eww/scripts/surface-state.sh show-control audio ${active_surface} ${active_flyout}"
      (box
        :orientation "h"
        :space-evenly false
        :spacing 8
        (label :class "volume-open-audio-label" :text "AUDIO")
        (label :class "volume-open-audio-icon" :text "")))

    (button
      :class "flyout-close"
      :tooltip "Close volume controls"
      :timeout "4s"
      :onclick "$HOME/.config/eww/scripts/surface-state.sh dismiss ${active_surface} ${active_flyout}"
      "")))

(defwindow volume-flyout
  :namespace "senomy-flyout"
  :geometry (geometry
    :x "128px"
    :y "10px"
    :width "420px"
    :height "96px"
    :anchor "bottom right")
  :stacking "overlay"
  :focusable false
  :exclusive false

  (box
    :class "volume-flyout compact-flyout shell-panel layout-${bar_layout?.data?.density ?: "standard"} appearance-font-${appearance_status?.data?.font_family ?: "jetbrains"} appearance-body-px-${appearance_status?.data?.body_px ?: 11} appearance-meta-px-${appearance_status?.data?.meta_px ?: 9} appearance-nav-px-${appearance_status?.data?.nav_px ?: 10} appearance-accent-${appearance_status?.data?.accent ?: "cyan"} appearance-gradient-${appearance_status?.data?.gradient ?: "subtle"}"
    :orientation "v"
    :space-evenly false
    (volume-flyout-content)))
