(defwindow main-bar
  :geometry (geometry :x "0" :y "1040" :width "100%" :height "40px")
  :stacking "fg"
  :monitor 0
  :exclusive true
  :anchor "top center"
  :visible true
  (box :class "bar" :orientation "h" :space-evenly false
    ;; left
    (workspace-indicator)

    ;; spacer so right group sticks to the end
    (box :hexpand true)

    ;; right
    (box :class "mainbar-right" :spacing 10 :halign "end" :hexpand false :space-evenly false
      (clock-button)
      (volume-button)
      (wifi-button)
    (battery-button))))