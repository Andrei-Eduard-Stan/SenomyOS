(defwindow main-bar
  :geometry (geometry :x "0" :y "0" :width "100%" :height "44px" :anchor "bottom center")
  :stacking "fg"
  :monitor 0
  :exclusive true
  :visible true

(centerbox
  :class "bar"
  :orientation "h"

  ;; Left half of the bar
  (centerbox
    :class "mainbar-left"
    :orientation "h"
    :hexpand true

    ;; Far left
    (box
      :halign "start"
      :space-evenly false
      (workspace-indicator))

    ;; Halfway between workspaces and system-summary
    (senomy-status)

    ;; Empty right slot keeps Senomy centred in this half
    (box))

  ;; True centre of the entire bar
  (system-summary)

  ;; Far right
  (box
    :class "mainbar-right"
    :spacing 10
    :halign "end"
    :space-evenly false
    (system-tray)
    (applications-button)
    (volume-button)
    (wifi-button)
    (battery-button)
    (clock-button))))
