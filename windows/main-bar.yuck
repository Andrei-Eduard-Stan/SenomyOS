(defwindow main-bar
  :geometry (geometry :x "0" :y "0" :width "100%" :height "44px" :anchor "bottom center")
  :stacking "fg"
  :monitor 0
  :exclusive true
  :visible true

  (centerbox :class "bar" :orientation "h"
    ;; left
    (box
      :class "mainbar-left"
      :halign "start"
      :space-evenly false
      (workspace-indicator))

    ;; center
    (system-summary)

    ;; right
    (box
      :class "mainbar-right"
      :spacing 10
      :halign "end"
      :space-evenly false
      (clock-button)
      (volume-button)
      (wifi-button)
      (battery-button))))
