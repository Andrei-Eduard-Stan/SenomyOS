(defwindow main-bar
  :geometry (geometry :x "0" :y "0" :width "100%" :height "44px" :anchor "bottom center")
  :stacking "fg"
  :exclusive true
  :visible true

(centerbox
  :class "bar ${bar_layout?.data?.density ?: "standard"} ${(bar_layout?.data?.phone ?: false) ? "layout-phone" : ""} appearance-font-${appearance_status?.data?.font_family ?: "jetbrains"} appearance-title-px-${appearance_status?.data?.title_px ?: 16} appearance-body-px-${appearance_status?.data?.body_px ?: 11} appearance-meta-px-${appearance_status?.data?.meta_px ?: 9} appearance-nav-px-${appearance_status?.data?.nav_px ?: 10} appearance-rail-px-${appearance_status?.data?.rail_px ?: 11} appearance-accent-${appearance_status?.data?.accent ?: "cyan"} appearance-gradient-${appearance_status?.data?.gradient ?: "subtle"}"
  :orientation "h"

  ;; Left zone
  (box :class "workspace-rail-zone" :halign "start"
    (workspace-indicator))

  ;; True center zone: Senomy and Performance share one visual segment.
  (box :class "bar-island-edge"
    (box
      :class "central-rail-island bar-island-fill"
      :space-evenly false
      (senomy-status)
      (box :class "central-island-divider")
      (system-summary)))

  ;; Right zone
  (box :class "bar-island-edge" :halign "end" :valign "center"
    (box
      :class "mainbar-right bar-island-fill"
      :spacing 2
      :space-evenly false
      (system-tray)
      (applications-button)
      (volume-button)
      (wifi-button)
      (battery-button)
      (clock-button)))))
