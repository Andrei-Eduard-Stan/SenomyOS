(defwidget control-tab [section icon text]
  (button
    :halign "fill"
    :class {control_section == section
      ? "control-tab shell-tab active"
      : "control-tab shell-tab"}
    :onclick "${EWW_CMD} update pending_action=none && $HOME/.config/eww/scripts/ui-action.sh control-section ${section}"
    (box
      :space-evenly false
      :spacing 10
      (label :class "shell-tab-icon" :text icon)
      (label :class "shell-tab-label" :xalign 0 :text text))))

(defwindow actioncenter
  :geometry (geometry
    :x "0px"
    :y "12px"
    :width "750px"
    :height "700px"
    :anchor "bottom right")
  :stacking "overlay"
  :focusable false
  :exclusive false

  (box
    :class "control-centre shell-panel layout-${bar_layout?.data?.density ?: "standard"} ${(bar_layout?.data?.phone ?: false) ? "layout-phone" : ""} appearance-font-${appearance_status?.data?.font_family ?: "jetbrains"} appearance-scale-${appearance_status?.data?.font_scale ?: "standard"} appearance-title-px-${appearance_status?.data?.title_px ?: 16} appearance-body-px-${appearance_status?.data?.body_px ?: 11} appearance-meta-px-${appearance_status?.data?.meta_px ?: 9} appearance-nav-px-${appearance_status?.data?.nav_px ?: 10} appearance-accent-${appearance_status?.data?.accent ?: "cyan"} appearance-gradient-${appearance_status?.data?.gradient ?: "subtle"}"
    :orientation "v"
    :space-evenly false
    :spacing 0

    (box
      :class "control-header shell-header"
      :space-evenly false
      :vexpand false
      (label
        :class "shell-header-mark"
        :text "")
      (box
        :class "shell-heading"
        :orientation "v"
        :space-evenly false
        :hexpand true
        (label
          :class "control-title shell-title"
          :xalign 0
          :text "SENOMY CONTROL CENTRE")
        (label
          :class "shell-subtitle"
          :xalign 0
          :text "Contextual system controls"))
      (button
        :class "control-close shell-close"
        :tooltip "Close Control Centre"
        :timeout "8s"
        :onclick "$HOME/.config/eww/scripts/surface-state.sh close control ${active_surface} ${active_flyout}"
        ""))

    (box
      :class "control-content shell-content"
      :orientation {(bar_layout?.data?.phone ?: false) ? "v" : "h"}
      :space-evenly false
      :vexpand true

      (scroll
        :class "control-tabs-scroll shell-nav"
        :vscroll {(bar_layout?.data?.phone ?: false) != true}
        :hscroll {(bar_layout?.data?.phone ?: false) == true}
        :vexpand {(bar_layout?.data?.phone ?: false) != true}

        (box
          :class "control-tabs"
          :orientation {(bar_layout?.data?.phone ?: false) ? "h" : "v"}
          :spacing 4

          (control-tab :section "overview" :icon "" :text "Overview")
          (control-tab :section "network" :icon "" :text "Network")
          (control-tab :section "audio" :icon "" :text "Audio")
          (control-tab :section "power" :icon "" :text "Power")
          (control-tab :section "calendar" :icon "" :text "Calendar")
          (control-tab :section "input" :icon "" :text "Input")
          (control-tab :section "devices" :icon "" :text "Devices")
          (control-tab :section "apps" :icon "" :text "Applications")
          (control-tab :section "appearance" :icon "󰏘" :text "Appearance")
          (control-tab :section "settings" :icon "" :text "Settings")))

      (box
        :class "control-body shell-body"
        :space-evenly false
        :vexpand true
        :hexpand true

        (control-overview-section)

        (control-network-section)

        (control-audio-section)

        (control-power-section)

        (control-calendar-section)

        (control-input-section)

        (control-devices-section)

        (applications-section)

        (control-appearance-section)

        (control-settings-section)))))
