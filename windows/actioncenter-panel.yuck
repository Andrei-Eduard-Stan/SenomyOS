(defwidget control-placeholder [title detail]
  (box
    :class "control-placeholder"
    :orientation "v"
    :space-evenly false
    :spacing 8
    (label
      :class "control-placeholder-title"
      :xalign 0
      :text title)
    (label
      :class "control-placeholder-detail"
      :xalign 0
      :limit-width 64
      :wrap true
      :text detail)))

(defwidget control-tab [section icon text]
  (button
    :halign "fill"
    :class {control_section == section
      ? "control-tab shell-tab active"
      : "control-tab shell-tab"}
    :onclick "${EWW_CMD} update pending_action=none control_section=${section}"
    (box
      :space-evenly false
      :spacing 10
      (label :class "shell-tab-icon" :text icon)
      (label :class "shell-tab-label" :xalign 0 :text text))))

(defwidget control-section-placeholder [section title detail]
  (box
    :halign "fill"
    :valign "start"
    :visible {control_section == section}
    (control-placeholder
      :title title
      :detail detail)))

(defwindow actioncenter
  :monitor 0
  :geometry (geometry
    :x "0px"
    :y "12px"
    :width "750px"
    :height "700px"
    :anchor "bottom right")
  :stacking "overlay"
  :focusable false
  :exclusive false

  (box
    :class "control-centre shell-panel"
    :orientation "v"
    :space-evenly false
    :spacing 0

    (box
      :class "control-header shell-header"
      :space-evenly false
      :vexpand false
      (label
        :class "shell-header-mark"
        :text "")
      (box
        :class "shell-heading"
        :orientation "v"
        :space-evenly false
        :hexpand true
        (label
          :class "control-title shell-title"
          :xalign 0
          :text "SENOMY CONTROL CENTRE")
        (label
          :class "shell-subtitle"
          :xalign 0
          :text "Contextual system controls"))
      (button
        :class "control-close shell-close"
        :tooltip "Close Control Centre"
        :timeout "2s"
        :onclick "$HOME/.config/eww/scripts/surface-state.sh close control"
        ""))

    (box
      :class "control-content shell-content"
      :space-evenly false
      :vexpand true

      (scroll
        :class "control-tabs-scroll shell-nav"
        :vscroll true
        :hscroll false
        :vexpand true

        (box
          :class "control-tabs"
          :orientation "v"
          :spacing 4

          (control-tab :section "overview" :icon "" :text "Overview")
          (control-tab :section "network" :icon "" :text "Network")
          (control-tab :section "audio" :icon "" :text "Audio")
          (control-tab :section "power" :icon "" :text "Power")
          (control-tab :section "calendar" :icon "" :text "Calendar")
          (control-tab :section "input" :icon "" :text "Input")
          (control-tab :section "devices" :icon "" :text "Devices")
          (control-tab :section "apps" :icon "" :text "Applications")
          (control-tab :section "settings" :icon "" :text "Settings")))

      (box
        :class "control-body shell-body"
        :space-evenly false
        :vexpand true
        :hexpand true

        (control-section-placeholder
          :section "overview"
          :title "Overview"
          :detail "Planned: concise status and the most useful system controls.")

        (control-section-placeholder
          :section "network"
          :title "Network"
          :detail "Planned: connectivity, interfaces and Wi-Fi controls.")

        (control-section-placeholder
          :section "audio"
          :title "Audio"
          :detail "Planned: outputs, inputs, volume and routing.")

        (control-section-placeholder
          :section "power"
          :title "Power"
          :detail "Planned: dual-battery details, charging state and power controls.")

        (control-section-placeholder
          :section "calendar"
          :title "Calendar"
          :detail "Planned: date, calendar and time-related controls.")

        (control-section-placeholder
          :section "input"
          :title "Input"
          :detail "Planned: keyboard layout, pointing devices and touch input.")

        (control-section-placeholder
          :section "devices"
          :title "Device Management"
          :detail "Planned: displays, audio endpoints, inputs and connected hardware.")

        (applications-section)

        (control-section-placeholder
          :section "settings"
          :title "Settings"
          :detail "Planned: SenomyOS shell and system preferences.")))))
