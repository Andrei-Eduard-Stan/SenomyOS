(defwidget control-placeholder [title detail]
  (box
    :class "control-placeholder"
    :orientation "v"
    :spacing 8
    (label
      :class "control-placeholder-title"
      :xalign 0
      :text title)
    (label
      :class "control-placeholder-detail"
      :xalign 0
      :wrap true
      :text detail)))

(defwindow actioncenter
  :monitor 0
  :geometry (geometry
    :x "-12px"
    :y "-52px"
    :width "520px"
    :height "360px"
    :anchor "bottom right")
  :stacking "overlay"
  :focusable false
  :exclusive false
  :visible {active_surface == "control"}

  (box
    :class "control-centre"
    :orientation "v"
    :spacing 12

    (box
      :class "control-header"
      :spacing 8
      (label
        :class "control-title"
        :xalign 0
        :text "SENOMY CONTROL CENTRE")
      (box :hexpand true)
      (button
        :class "control-close"
        :onclick "eww update active_surface=none"
        ""))

    (box
      :class "control-tabs"
      :spacing 8

      (button
        :class {control_section == "overview"
          ? "control-tab active"
          : "control-tab"}
        :onclick "eww update control_section=overview"
        "Overview")

      (button
        :class {control_section == "audio"
          ? "control-tab active"
          : "control-tab"}
        :onclick "eww update control_section=audio"
        "Audio")

      (button
        :class {control_section == "network"
          ? "control-tab active"
          : "control-tab"}
        :onclick "eww update control_section=network"
        "Network")

      (button
        :class {control_section == "devices"
          ? "control-tab active"
          : "control-tab"}
        :onclick "eww update control_section=devices"
        "Devices"))

    (box
      :class "control-body"
      :vexpand true

      (box
        :visible {control_section == "overview"}
        (control-placeholder
          :title "Overview"
          :detail "System controls and concise status will live here."))

      (box
        :visible {control_section == "audio"}
        (control-placeholder
          :title "Audio"
          :detail "Outputs, inputs, volume and routing are coming next."))

      (box
        :visible {control_section == "network"}
        (control-placeholder
          :title "Network"
          :detail "Connectivity, interfaces and Wi-Fi controls are coming next."))

      (box
        :visible {control_section == "devices"}
        (control-placeholder
          :title "Device Management"
          :detail "Displays, audio endpoints, inputs and connected hardware will appear here.")))))
