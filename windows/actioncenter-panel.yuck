(defwidget control-placeholder [title detail]
  (box
    :class "control-placeholder"
    :orientation "v"
    :spacing 8
    (label
      :class "control-placeholder-title"
      :xalign 0
      :text title)
    (label
      :class "control-placeholder-detail"
      :xalign 0
      :wrap true
      :text detail)))

(defwidget control-tab [section text]
  (button
    :halign "start"
    :class {control_section == section
      ? "control-tab active"
      : "control-tab"}
    :onclick "${EWW_CMD} update control_section=${section}"
    text))

(defwidget control-section-placeholder [section title detail]
  (box
    :visible {control_section == section}
    (control-placeholder
      :title title
      :detail detail)))

(defwindow actioncenter
  :monitor 0
  :geometry (geometry
    :x "0px"
    :y "0px"
    :width "750px"
    :height "700px"
    :anchor "bottom right")
  :stacking "overlay"
  :focusable false
  :exclusive false

  (box
    :class "control-centre"
    :orientation "v"
    :space-evenly false
    :spacing 0

    (box
      :class "control-header"
      :space-evenly false
      :vexpand false
      (label
        :class "control-title"
        :xalign 0
        :hexpand true
        :text "SENOMY CONTROL CENTRE")
      (button
        :class "control-close"
        :tooltip "Close Control Centre"
        :timeout "2s"
        :onclick "${EWW_CMD} update active_surface=none; ${EWW_CMD} close actioncenter"
        ""))

    (box
      :class "control-content"
      :space-evenly false
      :vexpand true

      (scroll
        :class "control-tabs-scroll"
        :vscroll true
        :hscroll false
        :vexpand true

        (box
          :class "control-tabs"
          :orientation "v"
          :spacing 4

          (control-tab :section "overview" :text "  Overview")
          (control-tab :section "network" :text "  Network")
          (control-tab :section "audio" :text "  Audio")
          (control-tab :section "power" :text "  Power")
          (control-tab :section "calendar" :text "  Calendar")
          (control-tab :section "input" :text "  Input")
          (control-tab :section "devices" :text "  Devices")
          (control-tab :section "apps" :text "  Applications")
          (control-tab :section "settings" :text "  Settings")))

      (box
        :class "control-body"
        :vexpand true
        :hexpand true

        (control-section-placeholder
          :section "overview"
          :title "Overview"
          :detail "Planned: concise status and the most useful system controls.")

        (control-section-placeholder
          :section "network"
          :title "Network"
          :detail "Planned: connectivity, interfaces and Wi-Fi controls.")

        (control-section-placeholder
          :section "audio"
          :title "Audio"
          :detail "Planned: outputs, inputs, volume and routing.")

        (control-section-placeholder
          :section "power"
          :title "Power"
          :detail "Planned: dual-battery details, charging state and power controls.")

        (control-section-placeholder
          :section "calendar"
          :title "Calendar"
          :detail "Planned: date, calendar and time-related controls.")

        (control-section-placeholder
          :section "input"
          :title "Input"
          :detail "Planned: keyboard layout, pointing devices and touch input.")

        (control-section-placeholder
          :section "devices"
          :title "Device Management"
          :detail "Planned: displays, audio endpoints, inputs and connected hardware.")

        (control-section-placeholder
          :section "apps"
          :title "Applications"
          :detail "Planned: background applications and system tray activity.")

        (control-section-placeholder
          :section "settings"
          :title "Settings"
          :detail "Planned: SenomyOS shell and system preferences.")))))
