          "source": "components/file-manager/thunar/thunar.desktop",
          "target": {
            "root": "xdg_data",
            "path": "applications/thunar.desktop"
          },
          "kind": "file",
          "strategy": "replace",
          "mode": "0644"
        },
        {
          "id": "action-helper",
          "source": "components/file-manager/thunar/scripts/senomy-thunar-action",
          "target": {
            "root": "user_bin",
            "path": "senomy-thunar-action"
          },
