          "id": "uca",
          "source": "components/file-manager/thunar/actions.json",
          "target": {
            "root": "xdg_config",
            "path": "Thunar/uca.xml"
          },
          "helper_target": {
            "root": "user_bin",
            "path": "senomy-thunar-action"
          },
          "kind": "file",
          "strategy": "thunar-uca-merge",
          "mode": "0600"
        }
      ]
    },
