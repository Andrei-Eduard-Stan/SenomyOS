{
  "schema_version": 1,
  "backup_namespace": "senomyos/deployments",
  "components": [
    {
      "id": "eww-live",
      "description": "The current Eww repository is already the live development tree.",
      "scope": "user",
      "readiness": "in-place",
      "reason": "No copy deployment is needed while the repository itself is the live Eww configuration.",
      "post_apply": [],
      "entries": []
    },
    {
      "id": "hyprland",
      "description": "Deploy the reviewed Hyprland Lua configuration before legacy .conf support is removed.",
      "scope": "user",
      "readiness": "ready",
      "reason": "The repository-owned Lua configuration is validated by Hyprland before every apply or rollback.",
      "warning": "Applying creates the live hyprland.lua selected at the next Hyprland start. It does not reload or replace the current session.",
      "pre_apply": [
        "hyprland-lua-valid",
        "swaybg-installed"
      ],
      "post_apply": [],
      "entries": [
        {
          "id": "config",
          "source": "hyprland.lua",
          "target": {
            "root": "xdg_config",
            "path": "hypr/hyprland.lua"
          },
          "kind": "file",
          "strategy": "replace",
          "mode": "0644"
        },
        {
          "id": "wallpaper-launcher",
          "source": "components/desktop/scripts/senomy-wallpaper",
          "target": {
            "root": "user_bin",
            "path": "senomy-wallpaper"
          },
          "kind": "file",
          "strategy": "replace",
          "mode": "0755"
        },
        {
          "id": "fullscreen-toggle",
          "source": "components/desktop/scripts/senomy-fullscreen",
          "target": {
            "root": "user_bin",
            "path": "senomy-fullscreen"
          },
          "kind": "file",
          "strategy": "replace",
          "mode": "0755"
        },
        {
          "id": "wallpaper",
          "source": "appearance/shared/backgrounds/desktop.png",
          "target": {
            "root": "xdg_data",
            "path": "senomyos/appearance/backgrounds/desktop.png"
          },
          "kind": "file",
          "strategy": "replace",
          "mode": "0644"
        }
      ]
    },
    {
      "id": "profile-automatic",
      "description": "Select adaptive portable defaults for unknown or mixed hardware.",
      "scope": "user",
      "readiness": "ready",
      "reason": "The automatic profile is schema-validated and preserves runtime geometry detection.",
      "post_apply": [],
      "entries": [
        {"id":"profile","source":"deploy/profiles/automatic.json","target":{"root":"xdg_config","path":"senomyos/profile.json"},"kind":"file","strategy":"replace","mode":"0644"}
      ]
    },
    {
      "id": "profile-desktop",
      "description": "Select pointer-first desktop density defaults.",
      "scope": "user",
      "readiness": "ready",
      "reason": "The desktop profile is schema-validated and contains no device identifiers.",
      "post_apply": [],
      "entries": [
        {"id":"profile","source":"deploy/profiles/desktop.json","target":{"root":"xdg_config","path":"senomyos/profile.json"},"kind":"file","strategy":"replace","mode":"0644"}
      ]
    },
    {
      "id": "profile-touch",
      "description": "Select touch-oriented typography and file-manager density defaults.",
      "scope": "user",
      "readiness": "ready",
      "reason": "The touch profile uses visible alternatives and 44px-or-larger toolkit targets.",
      "post_apply": [],
      "entries": [
        {"id":"profile","source":"deploy/profiles/touch.json","target":{"root":"xdg_config","path":"senomyos/profile.json"},"kind":"file","strategy":"replace","mode":"0644"}
      ]
    },
    {
      "id": "profile-narrow",
