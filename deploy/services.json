      "managed": true,
      "reason": "Disabled by user policy; never enabled by release deployment or first boot"
    },
    {
      "unit": "pipewire.socket",
      "policy": "preset",
      "required": true,
      "managed": false,
      "reason": "Package-managed audio activation"
    },
    {
      "unit": "pipewire-pulse.socket",
      "policy": "preset",
      "required": true,
      "managed": false,
      "reason": "Package-managed Pulse compatibility activation"
    },
    {
      "unit": "wireplumber.service",
      "policy": "preset",
      "required": true,
      "managed": false,
      "reason": "Package-managed audio policy"
    }
  ]
}
