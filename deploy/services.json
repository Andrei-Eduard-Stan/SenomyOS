{
  "schema_version": 1,
  "system": [
    {
      "unit": "NetworkManager.service",
      "policy": "enable",
      "required": true,
      "reason": "Network provider"
    },
    {
      "unit": "sddm.service",
      "policy": "enable",
      "required": true,
      "reason": "Graphical login manager"
    },
    {
      "unit": "bluetooth.service",
      "policy": "optional",
      "required": false,
      "reason": "Only required when Bluetooth is supported and enabled"
    }
  ],
  "user": [
    {
      "unit": "senomy-calendar.service",
      "policy": "enable",
      "required": false,
