    {
      "id": "battery-care",
      "description": "Install the narrow authenticated TLP battery-care transaction helper.",
      "scope": "system",
      "readiness": "ready",
      "reason": "Isolated validation/readback/recovery tests; separate system deployment and hardware acceptance required.",
      "warning": "Installs one root-owned helper only. No threshold, TLP configuration, profile, service, idle or lid changes. Each later apply/restore requires normal polkit authentication.",
      "post_apply": [],
      "entries": [
        {
          "id": "transaction-helper",
          "source": "components/power/battery_care.py",
          "target": {
            "root": "local_libexec",
            "path": "senomy-battery-care"
          },
          "mode": "0755"
        }
      ]
    }
