    {
      "id": "recovery",
      "description": "Install the restricted authenticated SenomyOS password-recovery runtime.",
      "scope": "system",
      "readiness": "ready",
      "reason": "The recovery session, constrained compositor, UI, hard-coded reset helper, and exact sudo rule are implemented.",
      "warning": "File deployment does not create or unlock the recovery account. Provision it separately and choose a strong independent credential.",
      "post_apply": [
        "recovery-runtime"
      ],
      "entries": [
        {
          "id": "session-entry",
          "source": "components/recovery/senomy-recovery.desktop",
          "target": {
            "root": "wayland_sessions",
            "path": "senomy-recovery.desktop"
          },
          "mode": "0644"
        },
        {
          "id": "session-launcher",
          "source": "components/recovery/senomy-recovery-session",
          "target": {
            "root": "local_libexec",
            "path": "senomy-recovery-session"
          },
          "mode": "0755"
        },
        {
          "id": "recovery-ui",
          "source": "components/recovery/senomy-recovery-ui",
          "target": {
            "root": "local_libexec",
            "path": "senomy-recovery-ui"
          },
          "mode": "0755"
        },
        {
          "id": "reset-helper",
          "source": "components/recovery/senomy-password-reset-helper",
          "target": {
            "root": "local_libexec",
            "path": "senomy-password-reset-helper"
          },
          "mode": "0755"
        },
        {
          "id": "hyprland-config",
          "source": "components/recovery/recovery-hyprland.lua",
          "target": {
            "root": "senomy_etc",
            "path": "recovery-hyprland.lua"
          },
          "mode": "0644"
        },
        {
          "id": "sudo-rule",
          "source": "components/recovery/senomy-recovery.sudoers",
          "target": {
            "root": "sudoers",
            "path": "senomy-recovery"
          },
          "mode": "0440"
        },
        {
          "id": "recovery-control",
          "source": "scripts/senomy-recoveryctl",
          "target": {
            "root": "local_sbin",
            "path": "senomy-recoveryctl"
          },
          "mode": "0755"
        }
      ]
    },
    {
      "id": "plymouth-staged",
      "description": "Stage the SenomyOS Plymouth theme without selecting it or rebuilding initramfs.",
      "scope": "system",
      "readiness": "ready",
      "reason": "Static theme files can be deployed independently of the boot-path activation gate.",
      "warning": "This installs theme files only. It never changes mkinitcpio/dracut configuration or regenerates an initramfs.",
      "post_apply": [],
      "entries": [
        {
          "id": "descriptor",
          "source": "appearance/boot/plymouth/senomyos/senomyos.plymouth",
          "target": {
