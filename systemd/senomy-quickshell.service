[Unit]
Description=SenomyOS Quickshell V2 development shell
Wants=graphical-session.target swaync.service
After=graphical-session.target swaync.service
OnFailure=senomy-shell-fallback.service
StartLimitIntervalSec=20
StartLimitBurst=3

[Service]
Type=simple
ExecStart=%h/.local/bin/senomy-quickshell-run
Restart=on-failure
RestartMode=direct
RestartSec=1
TimeoutStopSec=8

# Deliberately no [Install] section: Milestone 2 does not change login ownership.
