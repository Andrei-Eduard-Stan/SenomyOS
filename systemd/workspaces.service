[Unit]
Description=Eww workspaces listener (Hyprland -> Eww)
After=graphical-session.target
Wants=graphical-session.target
StartLimitIntervalSec=0

[Service]
Type=simple
Environment=EWW_CFG=%h/.config/eww
Environment=PATH=/usr/bin:/bin:/usr/local/bin
ExecStart=%h/.config/eww/scripts/workspaces.sh
Restart=on-failure
RestartSec=2

[Install]
WantedBy=default.target
